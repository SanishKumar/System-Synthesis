# Server Configuration
PORT=4000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
# Comma-separated additional browser origins, if required.
# ADDITIONAL_FRONTEND_ORIGINS=https://preview.example.com

# Required in production. Use a long, randomly generated secret.
JWT_SECRET=replace-with-at-least-32-random-bytes
# JWT_EXPIRES_IN_SECONDS=604800

# Redis Configuration (optional — falls back to in-memory)
# REDIS_URL=redis://localhost:6379
#
# The scheme decides encryption: rediss:// verifies the provider's certificate,
# redis:// does not encrypt. As with the database, plaintext to a host other
# than this machine is refused in production unless REDIS_ALLOW_PLAINTEXT=true.
# REDIS_CA_CERT and REDIS_SSL_NO_VERIFY behave like their database counterparts.

# PostgreSQL Configuration (optional — falls back to in-memory)
# A database on this machine needs nothing further; loopback is not encrypted.
# DATABASE_URL=postgresql://user:password@localhost:5432/system_synthesis
#
# Transport security is decided from the host and what the URL asks for, never
# from the scheme — postgres:// and postgresql:// are the same database:
#   host is localhost/127.0.0.1  no TLS unless the URL asks for it
#   any other host               TLS with the certificate verified against
#                                Node's bundled roots
#   sslmode=disable              no TLS at all, wherever it points
#
# A database that is not on this machine — including a container on a private
# network, such as the Docker development stack — must say so explicitly:
# DATABASE_URL=postgresql://user:password@postgres:5432/system_synthesis?sslmode=disable
#
# In production, sslmode=disable to a host other than this machine is refused,
# because it would send credentials and data across a network in the clear.
# Accept it deliberately, if that is genuinely what you want:
# DATABASE_ALLOW_PLAINTEXT=true
#
# If the provider's root is not one Node bundles, supply it inline, or point at
# a file with sslrootcert= in the URL. An inline value wins if both are given,
# and a file that cannot be read is refused rather than quietly replaced by
# Node's default roots.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
#
# ssl=true and ssl=false in the URL are read as well as sslmode. Client
# certificate parameters (sslcert, sslkey) are refused rather than ignored,
# because mutual authentication cannot be honoured here.
#
# Escape hatch. Encrypts without verifying the certificate, which leaves an
# active attacker able to read and rewrite every query. Set it only to restore
# service while a verification failure is diagnosed, and remove it after.
# DATABASE_SSL_NO_VERIFY=true

# GitHub App (optional — publishes the Architecture Decision check on a pull
# request). Without both values the decision is still recorded and audited; it
# simply is not mirrored to GitHub. See docs/GITHUB_APP_SETUP.md.
# GITHUB_APP_ID=123456
# The full PEM from the App's generated private key. A single-line value with
# escaped \n is accepted, so this works in providers whose UI is one line.
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEow...\n-----END RSA PRIVATE KEY-----\n"

# OpenAI API Key (optional — explains deterministic findings; never creates validation findings)
# OPENAI_API_KEY=sk-...

# Local LLM Endpoint (optional — alternative to OpenAI)
# LOCAL_LLM_URL=http://localhost:11434/api/generate
# LOCAL_LLM_MODEL=qwen2.5:7b
