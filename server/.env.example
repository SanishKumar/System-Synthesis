# Server Configuration
PORT=4000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
# Comma-separated additional browser origins, if required.
# ADDITIONAL_FRONTEND_ORIGINS=https://preview.example.com

# Required in production. Use a long, randomly generated secret.
JWT_SECRET=replace-with-at-least-32-random-bytes
# JWT_EXPIRES_IN_SECONDS=604800

# Redis Configuration (optional — falls back to in-memory)
# REDIS_URL=redis://localhost:6379

# PostgreSQL Configuration (optional — falls back to in-memory)
# DATABASE_URL=postgresql://user:password@localhost:5432/system_synthesis
#
# Transport security is decided from the connection string:
#   sslmode=disable   no TLS at all. For a local instance or a CI service
#                     container, which has none to negotiate.
#   anything else     TLS with the server's certificate verified against Node's
#                     bundled roots. This is the default for a postgresql:// URL.
# A connection that reaches its database without TLS today is left alone; only
# encrypted connections changed, from accepting any certificate to checking it.
#
# If the provider's root is not one Node bundles, supply it:
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
#
# Escape hatch. Encrypts without verifying the certificate, which leaves an
# active attacker able to read and rewrite every query. Set it only to restore
# service while a verification failure is diagnosed, and remove it after.
# DATABASE_SSL_NO_VERIFY=true

# GitHub App (optional — publishes the Architecture Decision check on a pull
# request). Without both values the decision is still recorded and audited; it
# simply is not mirrored to GitHub. See docs/GITHUB_APP_SETUP.md.
# GITHUB_APP_ID=123456
# The full PEM from the App's generated private key. A single-line value with
# escaped \n is accepted, so this works in providers whose UI is one line.
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEow...\n-----END RSA PRIVATE KEY-----\n"

# OpenAI API Key (optional — explains deterministic findings; never creates validation findings)
# OPENAI_API_KEY=sk-...

# Local LLM Endpoint (optional — alternative to OpenAI)
# LOCAL_LLM_URL=http://localhost:11434/api/generate
# LOCAL_LLM_MODEL=qwen2.5:7b
