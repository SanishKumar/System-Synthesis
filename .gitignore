node_modules/

# Build
.next/
dist/
!architecture-action/dist/
!architecture-action/dist/**
/.system-synthesis/reports/
out/

# Environment
# .env.example is deliberately not ignored: it is the configuration contract and
# carries placeholders only. Ignoring it kept the template out of the repository
# entirely, so a clone documented none of the required variables.
.env
.env.local
.env.*.local


# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts


